# Inhalte-Quelle: "storyblok" (Ziel) oder "supabase" (CMS-Light, Uebergangsbetrieb)
VITE_CONTENT_SOURCE=storyblok

# Storyblok (Space 296152904149561) — Tokens aus Settings -> Access Tokens
VITE_STORYBLOK_TOKEN=            # Public-Token: liefert nur veroeffentlichte Inhalte
VITE_STORYBLOK_PREVIEW_TOKEN=    # Preview-Token: nur fuer Vorschau-Deployments / Visual Editor
VITE_STORYBLOK_REGION=eu

# CMS-Light (nur noch fuer VITE_CONTENT_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Produktdatenbank (bleibt, read-only)
VITE_PRODUCT_SUPABASE_URL=https://ncvxzkwazdemivdolpzc.supabase.co
VITE_PRODUCT_SUPABASE_PUBLISHABLE_KEY=

# Download-Center (optional, eigene Datenbank bzw. Edge Function)
VITE_DOWNLOAD_SUPABASE_URL=
VITE_DOWNLOAD_SUPABASE_PUBLISHABLE_KEY=

# Entwicklungs-Hinweis "Body aus DB/Code" auch ausserhalb von `vite dev` anzeigen
VITE_SHOW_CMS_SOURCE_BADGE=0
